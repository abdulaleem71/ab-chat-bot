{
  "entities": {
    "tenants": {
      "title": "Tenant Organization",
      "description": "SaaS Multi-tenant accounts",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "plan": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "ownerEmail", "plan"]
    },
    "chatbots": {
      "title": "AI Chatbot",
      "description": "Custom AI support bot configuration",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "systemInstruction": { "type": "string" },
        "tone": { "type": "string" },
        "primaryColor": { "type": "string" },
        "avatar": { "type": "string" },
        "greetingMessage": { "type": "string" },
        "suggestedQuestions": { "type": "array", "items": { "type": "string" } },
        "model": { "type": "string" },
        "fallbackMessage": { "type": "string" },
        "collectLeadEmail": { "type": "boolean" },
        "leadTitle": { "type": "string" },
        "humanOperatorOnline": { "type": "boolean" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["tenantId", "name"]
    },
    "knowledge_sources": {
      "title": "Knowledge Base Source",
      "description": "Trained documents, URLs, and FAQs",
      "type": "object",
      "properties": {
        "chatbotId": { "type": "string" },
        "tenantId": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "sourceUrl": { "type": "string" },
        "status": { "type": "string" },
        "chunkCount": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["chatbotId", "tenantId", "type", "title"]
    },
    "conversations": {
      "title": "Live Customer Conversation",
      "description": "Visitor session history and status",
      "type": "object",
      "properties": {
        "chatbotId": { "type": "string" },
        "tenantId": { "type": "string" },
        "visitorId": { "type": "string" },
        "visitorName": { "type": "string" },
        "visitorEmail": { "type": "string" },
        "visitorLocation": { "type": "string" },
        "visitorBrowser": { "type": "string" },
        "pageUrl": { "type": "string" },
        "status": { "type": "string" },
        "lastMessage": { "type": "string" },
        "lastMessageTime": { "type": "string" },
        "unreadByAgent": { "type": "boolean" },
        "csatRating": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["chatbotId", "visitorId"]
    },
    "messages": {
      "title": "Chat Message",
      "description": "Single chat turn between visitor, AI bot, or human agent",
      "type": "object",
      "properties": {
        "conversationId": { "type": "string" },
        "chatbotId": { "type": "string" },
        "sender": { "type": "string" },
        "agentName": { "type": "string" },
        "content": { "type": "string" },
        "sourcesUsed": { "type": "array" },
        "timestamp": { "type": "string" }
      },
      "required": ["conversationId", "sender", "content"]
    },
    "analytics_events": {
      "title": "Analytics Event",
      "description": "Recorded platform telemetry and performance event",
      "type": "object",
      "properties": {
        "chatbotId": { "type": "string" },
        "tenantId": { "type": "string" },
        "eventType": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["chatbotId", "eventType"]
    }
  }
}
