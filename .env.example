# Local Development Database or Production Turso Connection URL
DATABASE_URL=file:nomadschat.db

# Turso Database Authentication Token (Required in Production for remote libsql:// URLs)
TURSO_AUTH_TOKEN=

# Secret key used for signing JWT tokens
JWT_SECRET=

# Gemini API Key for AI responses and embeddings
GEMINI_API_KEY=

# Server listening port
PORT=

# Application Base URL
APP_URL=
